# Skylark Drones — AI Business Intelligence Agent
# Copy this file to .env and fill in your actual credentials

# ── Monday.com API ──────────────────────────────────────────────────────────
# Get your Personal API Token from: monday.com → Profile → Admin → API
MONDAY_API_TOKEN=your_personal_monday_api_token_here

# Board IDs (visible in Monday URL: monday.com/boards/<BOARD_ID>)
MONDAY_DEALS_BOARD_ID=your_deals_board_id
MONDAY_WORK_ORDERS_BOARD_ID=your_work_orders_board_id

# ── AI / LLM Credentials (at least one required) ────────────────────────────
# Groq (recommended - free tier, very fast): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (fallback): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
